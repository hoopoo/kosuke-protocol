# OpenAI API Key for LLM-powered generation (never commit real keys)
OPENAI_API_KEY=

# Deep Reading feature flag (default: true). When false, Deep Reading routes return 503.
DEEP_READING_ENABLED=true
# v1.1-exp Context Pack (default off in production — Strict path only when false)
DEEP_READING_CONTEXT_PACK_ENABLED=false

# Session store: memory (local/tests) | do (Cloudflare Durable Object HTTP)
SESSION_STORE_BACKEND=memory
SESSION_STORE_URL=
SESSION_STORE_TOKEN=
SESSION_TTL_HOURS=24

# CORS: comma-separated frontend origins for staging/prod (empty = allow *)
CORS_ALLOW_ORIGINS=

# Optional: environment label for observability logs
ENV=dev
